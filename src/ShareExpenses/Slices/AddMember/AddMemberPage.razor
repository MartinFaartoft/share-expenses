@using ShareExpenses.Shared
<Page Title="Add member">
    <nav class="back"><a href="/groups/@Form.GroupId">← @Form.GroupName</a></nav>

    <section aria-labelledby="people">
        <h2 id="people">In this group</h2>
        <ul class="people">
            @foreach (var person in Form.People)
            {
                <li><span>@person.Name</span> <span class="status">@person.Status</span></li>
            }
        </ul>
    </section>

    <form method="post" action="/groups/@Form.GroupId/members">
        <AntiforgeryToken />
        @* Chosen when the form was shown: submitting it twice adds one member. *@
        <input type="hidden" name="memberId" value="@Form.MemberId" />
        <label>
            Name
            <input name="displayName" value="@Form.DisplayName" maxlength="@Names.DisplayNameMaxLength" required autofocus autocomplete="off" />
            <span class="hint">What the others in the group see them as.</span>
        </label>
        <label>
            Email (optional)
            <input type="email" name="email" value="@Form.Email" autocomplete="off" />
            <span class="hint">Give an email to invite them now. Without one they are added and can be invited later.</span>
        </label>
        @if (Form.Error is not null)
        {
            <p class="error" role="alert">@Form.Error</p>
        }
        <button type="submit">Add member</button>
    </form>
</Page>

@code {
    [Parameter] public AddMemberForm Form { get; set; } = default!;
}
