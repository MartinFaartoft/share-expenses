@* Step 1: the address to send a code to. Posts as a form; htmx swaps in step 2. *@
<form method="post" action="/sign-in/code" hx-post="/sign-in/code" hx-target="#sign-in">
    <AntiforgeryToken />
    <p>We'll email you a six-digit code. No password needed.</p>
    <label>
        Email
        <input name="email" type="email" value="@Email" autocomplete="email" required autofocus />
    </label>
    @if (Error is not null)
    {
        <p class="error" role="alert">@Error</p>
    }
    <button type="submit">Send me a code</button>
</form>

@code {
    [Parameter] public string Email { get; set; } = "";
    [Parameter] public string? Error { get; set; }
}
