@* The Settings screen: the colour theme. (Signing out is in the home page's menu.) *@
<Page Title="Settings" BackHref="/">
    <form method="post" action="/settings/theme">
        <AntiforgeryToken />
        <fieldset>
            <legend>Appearance</legend>
            <div class="modes">
                <label class="mode"><input type="radio" name="theme" value="device" checked="@(Choice == Theme.Device)" /> Device</label>
                <label class="mode"><input type="radio" name="theme" value="light" checked="@(Choice == Theme.Light)" /> Light</label>
                <label class="mode"><input type="radio" name="theme" value="dark" checked="@(Choice == Theme.Dark)" /> Dark</label>
            </div>
            <p class="hint">Choice is kept on this device only.</p>
        </fieldset>
        @if (Error is not null)
        {
            <p class="error" role="alert">@Error</p>
        }
        <button type="submit">Save</button>
    </form>
</Page>

@code {
    [Parameter] public string Choice { get; set; } = Theme.Device;
    [Parameter] public string? Error { get; set; }
}
