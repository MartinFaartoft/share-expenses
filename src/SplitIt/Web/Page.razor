@* The shell every screen renders inside: one stylesheet, htmx, a phone-first viewport. *@
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Title · SplitIt</title>
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'><text x='64' y='96' text-anchor='middle' font-size='110'>💸</text></svg>"
>
    <script src="/js/htmx-2.0.4.min.js" defer></script>
</head>
<body>
    <main>
        <h1>@Title</h1>
        @ChildContent
    </main>
</body>
</html>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
