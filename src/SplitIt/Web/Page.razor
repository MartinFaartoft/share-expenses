@* The shell every screen renders inside: one stylesheet, htmx and the two small scripts, a phone-first viewport. *@
<!doctype html>
<html lang="en" data-theme="@ThemeChoice">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Title · SplitIt</title>
    <link rel="stylesheet" href="/css/site.css" />
    
    <link rel="icon" type="image/png" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png">

    @* htmx's defaults, plus a 404 swapped in: a card whose expense is gone answers with a sheet saying so. *@
    <meta name="htmx-config" content="@HtmxConfig" />
    <script src="/js/htmx-2.0.4.min.js" defer></script>
    <script src="/js/sheet.js" defer></script>
    <script src="/js/exact-total.js" defer></script>
</head>
<body>
    @if (TopBar is not null)
    {
        <header class="topbar">@TopBar</header>
    }
    else if (BackHref is not null)
    {
        <header class="topbar">
            <a class="up" href="@BackHref" aria-label="Back">‹</a>
            <h1>@Title</h1>
        </header>
    }
    <main>
        @if (TopBar is null && BackHref is null)
        {
            <h1>@Title</h1>
        }
        @ChildContent
    </main>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    /// <summary>The theme the person chose on this device (the cookie), or null: the device decides.</summary>
    private string? ThemeChoice => Http is null ? null : Theme.Of(Http.Request);

    private const string HtmxConfig = """{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"404","swap":true,"error":false},{"code":"[45]..","swap":false,"error":true},{"code":"...","swap":true}]}""";

    [Parameter] public string Title { get; set; } = "";
    /// <summary>Where "back" goes: shows a sticky bar with a back chevron and the title.</summary>
    [Parameter] public string? BackHref { get; set; }
    /// <summary>A sticky app bar (back, title, menu) that replaces the plain heading.</summary>
    [Parameter] public RenderFragment? TopBar { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
