@* The New group screen (slice-01-create-group.md): a plain form; created, it goes into the group. *@
@using SplitIt.Shared
@using SplitIt.Slices.CreateGroup
<Page Title="New group" BackHref="/">
    <form method="post" action="/groups">
        <AntiforgeryToken />
        @* Chosen when the form was shown: submitting it twice creates one group. *@
        <input type="hidden" name="groupId" value="@Form.GroupId" />
        <label>
            Group name
            <input name="groupName" value="@Form.GroupName" maxlength="@Names.GroupNameMaxLength" required autofocus />
        </label>
        <label>
            Currency
            <select name="currency">
                @foreach (var iso in Currency.Codes)
                {
                    <option value="@iso" selected="@(iso == Form.Currency)">@Money.Label(iso)</option>
                }
            </select>
        </label>
        <label>
            Your name in this group
            <input name="memberName" value="@Form.MemberName" maxlength="@Names.DisplayNameMaxLength" required autocomplete="given-name" />
            <span class="hint">What the others in the group see you as.</span>
        </label>
        @if (Form.Error is not null)
        {
            <p class="error" role="alert">@Form.Error</p>
        }
        <button type="submit">Create group</button>
    </form>
</Page>

@code {
    [Parameter] public NewGroupForm Form { get; set; } = default!;
}
