@* The Rename group screen (slice-14-rename-group.md): a plain form; saved, it goes back to the group. *@
@using SplitIt.Shared
<Page Title="Rename group" BackHref="@($"/groups/{Form.GroupId}")">
    <form method="post" action="/groups/@Form.GroupId/rename">
        <AntiforgeryToken />
        <label>
            Group name
            <input name="name" value="@Form.Name" maxlength="@Names.GroupNameMaxLength" required autofocus />
        </label>
        @if (Form.Error is not null)
        {
            <p class="error" role="alert">@Form.Error</p>
        }
        <button type="submit">Save</button>
    </form>
</Page>

@code {
    [Parameter] public RenameForm Form { get; set; } = default!;
}
