<Page Title="SplitIt">
    <TopBar>
        <img class="logo" src="/favicon-180x180.png" alt="" width="36" height="36" />
        <h1>SplitIt</h1>
        <details class="menu">
            <summary aria-label="More">⋯</summary>
            <div class="menu-items">
                <a href="/settings">Settings</a>
                <form method="post" action="/sign-out">
                    <AntiforgeryToken />
                    <button type="submit">Sign out</button>
                </form>
            </div>
        </details>
    </TopBar>
    <ChildContent>
    @if (Model.Invites.Count > 0)
    {
        <section aria-labelledby="invites">
            <h2 id="invites">Invited</h2>
            <ul class="cards">
                @foreach (var invite in Model.Invites)
                {
                    <li>
                        <p><strong>@invite.InvitedBy</strong> invited you to <strong>@invite.GroupName</strong> as @invite.MemberName.</p>
                        <form method="post" action="/invites/@invite.GroupId/join">
                            <AntiforgeryToken />
                            <button type="submit">Join</button>
                        </form>
                    </li>
                }
            </ul>
        </section>
    }

    <section aria-labelledby="groups">
        <h2 id="groups">Your groups</h2>
        @if (Model.Groups.Count == 0)
        {
            <p class="hint">You're not in any groups yet. Start one, or wait for an invite.</p>
        }
        else
        {
            <ul class="links">
                @foreach (var group in Model.Groups)
                {
                    <li><a href="/groups/@group.GroupId">@group.Name</a></li>
                }
            </ul>
        }
    </section>

    @if (Model.Archived.Count > 0)
    {
        <details class="archived">
            <summary>Archived (@Model.Archived.Count)</summary>
            <ul class="links">
                @foreach (var group in Model.Archived)
                {
                    <li><a href="/groups/@group.GroupId">@group.Name</a></li>
                }
            </ul>
        </details>
    }

    <a class="fab" href="/groups/new" aria-label="New group">+</a>
    </ChildContent>
</Page>

@code {
    [Parameter] public HomepageReadModel Model { get; set; } = null!;
}
