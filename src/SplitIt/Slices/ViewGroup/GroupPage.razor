<Page Title="@ReadModel.GroupName">
    <TopBar>
        <a class="up" href="/" aria-label="Home">‹</a>
        <h1>@ReadModel.GroupName</h1>
        @if (!ReadModel.Archived)
        {
            <details class="menu">
                <summary aria-label="More">⋯</summary>
                <div class="menu-items">
                    <a href="/groups/@ReadModel.GroupId/members/new">Add member</a>
                    <a href="/groups/@ReadModel.GroupId/rename">Rename group</a>
                    <a href="/groups/@ReadModel.GroupId/default-split">Default split</a>
                    <a href="/groups/@ReadModel.GroupId/archive">Archive group</a>
                </div>
            </details>
        }
    </TopBar>
    <ChildContent>
    @if (ReadModel.Archived)
    {
        <p class="banner" role="status">This group is archived.</p>
    }
    <section class="summary" aria-label="Your balance">
        <a class="balance" href="/groups/@ReadModel.GroupId/balances">
            @if (ReadModel.BalanceMinor < 0)
            {
                <span>You owe <strong>@Money.Format(ReadModel.BalanceMinor, ReadModel.Currency)</strong></span>
            }
            else if (ReadModel.BalanceMinor > 0)
            {
                <span>You are owed <strong>@Money.Format(ReadModel.BalanceMinor, ReadModel.Currency)</strong></span>
            }
            else
            {
                <span>You're settled up</span>
            }
            <span class="chevron" aria-hidden="true">›</span>
        </a>
        @if (ReadModel.BalanceMinor != 0 && !ReadModel.Archived)
        {
            <a class="button" href="/groups/@ReadModel.GroupId/settle-up">Settle up</a>
        }
    </section>

    <section aria-labelledby="history">
        <h2 id="history">History</h2>
        @if (ReadModel.History.Count == 0)
        {
            <p class="hint">@(ReadModel.Archived ? "Nothing was ever recorded." : "Nothing yet. Add the first expense.")</p>
        }
        else
        {
            @* Newest first in the markup; column-reverse shows it at the bottom, scrolled into view. *@
            <ol class="history">
                @foreach (var entry in ReadModel.History)
                {
                    @switch (entry)
                    {
                        case ActivityExpense e:
                            <li class="@Side(e.PayerMemberId) expense">
                                <a class="card" href="/groups/@ReadModel.GroupId/expenses/@e.ExpenseId"
                                   hx-get="/groups/@ReadModel.GroupId/expenses/@e.ExpenseId" hx-target="#sheet" hx-swap="innerHTML">
                                    <span class="what">@e.Description</span>
                                    <span class="amount">@Money.Format(e.AmountMinor, ReadModel.Currency)</span>
                                    <span class="meta">@Who(e.PayerMemberId, e.PayerName) paid · @Day(e.PaidOn)</span>
                                </a>
                            </li>
                            break;
                        case ActivitySettlement s:
                            <li class="@Side(s.FromMemberId) settlement">
                                <span class="what">@Who(s.FromMemberId, s.FromName) paid @(s.ToMemberId == ReadModel.You ? "you" : s.ToName)</span>
                                <span class="amount">@Money.Format(s.AmountMinor, ReadModel.Currency)</span>
                                <span class="meta">Settlement · @Day(s.PaidOn)</span>
                            </li>
                            break;
                    }
                }
            </ol>
        }
    </section>

    @* Where an expense's sheet is swapped in (View expense): this slice knows its address and this id. *@
    <div id="sheet"></div>

    @if (!ReadModel.Archived)
    {
        <a class="fab" href="/groups/@ReadModel.GroupId/expenses/new" aria-label="Add expense">+</a>
    }
    </ChildContent>
</Page>

@code {
    [Parameter] public GroupActivityReadModel ReadModel { get; set; } = null!;
    
    private string Side(Shared.MemberId payer) => payer == ReadModel.You ? "mine" : "theirs";

    private string Who(Shared.MemberId member, string name) => member == ReadModel.You ? "You" : name;

    private static string Day(DateOnly day) => day.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
}
